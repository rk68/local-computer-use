{
  "name": "halo-runtime",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "start": "node --import tsx src/server.ts",
    "halo": "node --import tsx src/launcher.ts",
    "cleanup": "node --import tsx src/cleanup.ts",
    "setup-gateway": "node --import tsx src/setup-gateway.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "@trycua/cua": "0.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.59.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
